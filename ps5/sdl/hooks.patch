+// PS5 port: the launcher provides the console's audio output (ps5_io.cpp).
+extern void mh_ps5_audio_play(const void *frames, int count) __attribute__((weak));
+
+static bool DUMMYAUDIO_PlayDevice(SDL_AudioDevice *device, const Uint8 *buffer, int buflen)
+{
+    if (mh_ps5_audio_play) {
+        mh_ps5_audio_play(buffer, buflen / 4);  // 16-bit stereo frames
+    }
+    return true;
+}
+
 static bool DUMMYAUDIO_WaitDevice(SDL_AudioDevice *device)
 {
+    if (mh_ps5_audio_play && !device->recording) {
+        return true;  // PlayDevice blocks at the console's pace
+    }
     SDL_Delay(device->hidden->io_delay);
     return true;
 }
